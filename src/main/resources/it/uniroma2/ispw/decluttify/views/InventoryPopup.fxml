<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="15" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.uniroma2.ispw.decluttify.view.controller.jfx.JFXInventoryPopupController">
    <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Your Inventory" />
   <HBox maxWidth="1.7976931348623157E308" nodeOrientation="LEFT_TO_RIGHT">
      <children>
         <Label text="Select items to add in offer (max. 3 items)">
            <font>
               <Font size="14.0" />
            </font>
         </Label>
      </children>
   </HBox>
   <ScrollPane hbarPolicy="NEVER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS">
      <content>
      
          <GridPane fx:id="grid" hgap="20.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" vgap="20.0">
      
              <!-- cell width -->
              <columnConstraints>
                  <ColumnConstraints maxWidth="150" minWidth="150" prefWidth="150" />
                  <ColumnConstraints maxWidth="150" minWidth="150" prefWidth="150" />
              </columnConstraints>
      
              <!-- cell height -->
              <rowConstraints>
                  <RowConstraints maxHeight="1.7976931348623157E308" vgrow="ALWAYS" />
                  <RowConstraints maxHeight="1.7976931348623157E308" vgrow="ALWAYS" />
              </rowConstraints>
      
               <VBox alignment="CENTER_LEFT" spacing="5" styleClass="item-card-vbox">
               <HBox alignment="TOP_CENTER">
                  <children>
                         <ImageView fx:id="itemImageView" fitHeight="60.0" fitWidth="60.0" nodeOrientation="INHERIT" preserveRatio="true" />
                  </children>
               </HBox>
                   <Label fx:id="nameLabel" styleClass="item-title" />
                   <Label fx:id="offersCountLabel" styleClass="item-subtitle" />
                   <Label fx:id="conditionLabel" styleClass="item-badge" />
               <Region prefHeight="200.0" prefWidth="200.0" />
               <HBox alignment="CENTER_RIGHT">
                  <children>
                        <CheckBox fx:id="selectCheckBox" style="-fx-scale-x: 1.5; -fx-scale-y: 1.5;" styleClass="selection-checkbox" />
                  </children>
               </HBox>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <GridPane.margin>
                  <Insets />
               </GridPane.margin>
               </VBox>
            <padding>
               <Insets top="5.0" />
            </padding>
      
          </GridPane>
      </content>
      <padding>
         <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
      </padding>
   </ScrollPane>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button onAction="#handleCancel" text="Cancel" />
        <Button onAction="#handleAddItems" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Add Items" />
    </HBox>
</VBox>
