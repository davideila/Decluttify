<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<TabPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-tab-min-width: 150;" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <tabs>
        <!-- TAB 1: RECEIVED OFFERS -->
        <Tab text="Received offers">
            <content>
                <VBox spacing="10.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <children>

                        <HBox alignment="CENTER" style="-fx-background-color: #e0e0e0; -fx-padding: 8; -fx-background-radius: 5;">
                            <children>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label style="-fx-font-weight: bold;" text="YOU GET" HBox.hgrow="ALWAYS" />
                        <Region HBox.hgrow="ALWAYS" />
                                <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" HBox.hgrow="NEVER" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label style="-fx-font-weight: bold;" text="YOU GIVE" HBox.hgrow="ALWAYS" />
                                <Region HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="vboxReceivedOffers" spacing="20.0">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding></VBox>
                            </content>
                        </ScrollPane>

                    </children>
                </VBox>
            </content>
        </Tab>

        <!-- TAB 2: SENT OFFERS -->
        <Tab text="Sent offers">
            <content>
                <VBox spacing="10.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <children>

                        <HBox alignment="CENTER" style="-fx-background-color: #e0e0e0; -fx-padding: 8; -fx-background-radius: 5;">
                            <children>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label style="-fx-font-weight: bold;" text="YOU GIVE" HBox.hgrow="ALWAYS" />
                                <Region HBox.hgrow="ALWAYS" />
                                <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" HBox.hgrow="NEVER" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label style="-fx-font-weight: bold;" text="YOU GET" HBox.hgrow="ALWAYS" />
                                <Region HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="vboxSentOffers" spacing="20.0">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding></VBox>
                            </content>
                        </ScrollPane>

                    </children>
                </VBox>
            </content>
        </Tab>
    </tabs>
   <padding>
      <Insets left="10.0" right="10.0" />
   </padding>
</TabPane>
